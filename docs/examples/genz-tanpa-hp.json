{
  "title": "Gen Z Tanpa HP dan Sosmed",
  "voice": "brian",
  "voices": {
    "narator": "brian",
    "raka": "liam",
    "parkir": "callum",
    "bapak": "daniel"
  },
  "language": "id",
  "music": "ceria",
  "caption_color": "#FFD23F",
  "script": [
    {
      "text": "Gimana jadinya kalau Gen Z tanpa HP dan sosmed?",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "HP gue mana? Kok... radio?!",
      "speaker": "raka",
      "gap": 1.0
    },
    {
      "text": "Selamat datang di dunia tanpa notifikasi.",
      "speaker": "narator",
      "gap": 0.4
    },
    {
      "text": "Ini colokan apaan?!",
      "speaker": "raka",
      "gap": 1.0
    },
    {
      "text": "Mau cek cuaca? Tunggu berita jam enam.",
      "speaker": "narator",
      "gap": 0.8
    },
    {
      "text": "Mau dengar lagu favorit? Tunggu diputar penyiar, lalu rekam pakai kaset.",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "Janjian harus tepat waktu. Nggak ada otw, nggak ada share lok.",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "Pak, Jalan Melati di mana?",
      "speaker": "raka",
      "gap": 0.4
    },
    {
      "text": "Lurus, kiri, kanan, tanya lagi.",
      "speaker": "parkir",
      "gap": 1.2
    },
    {
      "text": "Nongkrong tanpa HP? Semua orang terpaksa... ngobrol.",
      "speaker": "narator",
      "gap": 1.4
    },
    {
      "text": "Kerja nggak bisa sambil scroll. Jempol lu bingung mau ngapain.",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "Kirim file? Pakai mesin faks. Lima menit buat satu halaman.",
      "speaker": "narator",
      "gap": 1.4
    },
    {
      "text": "Kok kerjaan gue udah beres?!",
      "speaker": "raka",
      "gap": 1.2
    },
    {
      "text": "Mau kenalan? Harus langsung. Nggak bisa follow dulu.",
      "speaker": "narator",
      "gap": 0.8
    },
    {
      "text": "Kirim surat, tunggu balasan dua minggu.",
      "speaker": "narator",
      "gap": 1.6
    },
    {
      "text": "Ini siapa? Mau apa?",
      "speaker": "bapak",
      "gap": 1.4
    },
    {
      "text": "Untungnya... cuma mimpi.",
      "speaker": "narator",
      "gap": 3.0
    },
    {
      "text": "Balikin gue ke sembilan puluhan.",
      "speaker": "raka"
    }
  ],
