{
  "title": "Kota Tertib vs Kota Terserah - Part 1: Berangkat Kerja",
  "voice": "brian",
  "voices": {
    "narator": "brian",
    "budi": "george",
    "pak_rt": "daniel",
    "supir": "will",
    "parkir": "callum"
  },
  "language": "id",
  "music": "ceria",
  "caption_color": "#FFD23F",
  "script": [
    {
      "text": "Dua kota. Sama-sama jam tujuh pagi. Satu misi: berangkat kerja.",
      "speaker": "narator",
      "gap": 1.4
    },
    {
      "text": "Di Kota Tertib, bus datang tepat waktu.",
      "speaker": "narator",
      "pause": 0.3,
      "gap": 0.9
    },
    {
      "text": "Saking tepatnya, warga nyetel jam pakai bus.",
      "speaker": "narator",
      "pause": 0.4,
      "gap": 1.8
    },
    {
      "text": "Sampai jam tujuh lima belas. Masih sempat ngopi.",
      "speaker": "budi",
      "pause": 0.4,
      "gap": 1.0
    },
    {
      "text": "Di Kota Terserah, angkot nunggu penuh.",
      "speaker": "narator",
      "pause": 0.4,
      "gap": 0.6
    },
    {
      "text": "Bentar, Pak. Tunggu penuh.",
      "speaker": "supir",
      "gap": 0.6
    },
    {
      "text": "Satu lagi! Satu lagi!",
      "speaker": "supir",
      "pause": 0.2,
      "gap": 0.9
    },
    {
      "text": "Penumpangnya naik masih SMA… turun sudah punya cucu.",
      "speaker": "narator",
      "pause": 0.3,
      "gap": 4.8
    },
    {
      "text": "Udah, naik motor aja.",
      "speaker": "pak_rt",
      "gap": 1.1
    },
    {
      "text": "Prit! Dua ribu, Bang.",
      "speaker": "parkir",
      "pause": 0.5,
      "gap": 1.3
    },
    {
      "text": "Prit! Kiri, kiri…",
      "speaker": "parkir",
      "pause": 0.5,
      "gap": 1.5
    },
    {
      "text": "Terus, terus, terus…",
      "speaker": "parkir",
      "pause": 0.4,
      "gap": 1.8
    },
    {
      "text": "Tapi setiap akhir pekan, warga Kota Tertib liburan ke Kota Terserah.",
      "speaker": "narator",
      "pause": 0.4,
      "gap": 0.6
    },
    {
      "text": "Dua ribu, Bang.",
      "speaker": "parkir",
      "gap": 0.7
    },
    {
      "text": "AKHIRNYA!",
      "speaker": "budi",
      "pause": 0.2,
      "gap": 1.8
    },
    {
      "text": "Kamu tinggal di kota yang mana?",
      "speaker": "narator",
      "pause": 0.5
    }
  ],
