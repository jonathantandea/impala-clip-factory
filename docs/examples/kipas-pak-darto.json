  "script": [
    {
      "text": "Pak Darto punya kipas angin yang cuma nyala kalau ada tamu.",
      "gap": 0.5
    },
    {
      "text": "Tamu datang, kipasnya langsung muter kencang.",
      "gap": 0.4
    },
    {
      "text": "Tamu pulang... kipasnya mati sendiri.",
      "gap": 0.6
    },
    {
      "text": "Satu kampung heboh. Katanya kipasnya pintar. Ada yang bilang... ada penunggunya.",
      "gap": 0.5
    },
    {
      "text": "Pak RT sampai datang sendiri buat membuktikan.",
      "gap": 0.5
    },
    {
      "text": "Ternyata...",
      "speed": 0.85,
      "settings": {
        "stability": 0.6
      },
      "gap": 3.0
    },
    {
      "text": "Pak Darto nginjak saklar di bawah meja. Biar listrik hemat, tapi tamu tetap adem."
    }
  ],
