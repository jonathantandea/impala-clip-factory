{
  "title": "Ini Jadinya Kalau Tidak Ada Badak",
  "voice": "brian",
  "voices": {
    "narator": "brian",
    "udin": "charlie",
    "bibit": "jessica",
    "rusa": "sarah",
    "kancil": "liam"
  },
  "language": "id",
  "music": "ceria",
  "caption_color": "#FFD23F",
  "script": [
    {
      "text": "Satu hari, semua badak hilang dari hutan.",
      "speaker": "narator",
      "gap": 1.6
    },
    {
      "text": "Santai. Cuma satu hewan. Hutan aman.",
      "speaker": "udin",
      "gap": 0.8
    },
    {
      "text": "Salah besar. Mulai hari pertama, masalah datang satu-satu.",
      "speaker": "narator",
      "gap": 1.4
    },
    {
      "text": "Badak itu kurir biji. Badak sumatera bantu menyebarkan biji sekitar tujuh puluh sembilan jenis tumbuhan.",
      "speaker": "narator",
      "gap": 1.2
    },
    {
      "text": "Caranya? Lewat pup. Bijinya ikut jalan-jalan, lalu tumbuh di pupuk gratis.",
      "speaker": "narator",
      "gap": 1.2
    },
    {
      "text": "Tanpa badak, biji numpuk di bawah induknya dan rebutan tempat.",
      "speaker": "narator",
      "gap": 0.3
    },
    {
      "text": "Minggir!",
      "speaker": "bibit",
      "gap": 1.2
    },
    {
      "text": "Badak juga rajin memangkas dedaunan di lantai hutan. Tanpa mereka, hutan bisa jadi rapat dan berduri.",
      "speaker": "narator",
      "gap": 1.6
    },
    {
      "text": "Aduh! Sandal gue! Topi gue!",
      "speaker": "udin",
      "gap": 1.2
    },
    {
      "text": "Kubangan lumpur bikinan badak? Kering. Padahal itu tempat minum hewan lain.",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "Airnya mana?",
      "speaker": "rusa",
      "gap": 1.2
    },
    {
      "text": "Jalan setapak yang biasa dibuka badak juga dipakai hewan lain. Lama-lama, hilang.",
      "speaker": "narator",
      "gap": 1.0
    },
    {
      "text": "Ini di mana?",
      "speaker": "kancil",
      "gap": 1.4
    },
    {
      "text": "Oke! Badak penting! Balikin badaknya, sekarang!",
      "speaker": "udin",
      "gap": 2.2
    },
    {
      "text": "Masalahnya, di dunia nyata badak nggak bisa muncul lagi pakai asap.",
      "speaker": "narator",
      "gap": 1.2
    },
    {
      "text": "Badak jawa tinggal puluhan ekor, dan cuma ada di Ujung Kulon. Satu-satunya di dunia.",
      "speaker": "narator",
      "gap": 1.6
    },
    {
      "text": "Jangan pergi lagi, Do.",
      "speaker": "udin"
    }
  ],
